# Copy to .env.local for local development. In production, set these in
# Vercel → Project → Settings → Environment Variables. Never commit real values.

# Your site's address, no trailing slash.
SITE_URL=http://localhost:3000

# Sign-in. AUTH_SECRET must be a long random string (40+ characters).
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google accounts allowed into the Hub and Studio (comma-separated).
OWNER_EMAILS=

# Saving from the Studio (commits to this repo). Leave empty locally to save
# straight to content/site.json.
GITHUB_TOKEN=
GITHUB_REPO=your-github-username/3XOBA
GITHUB_BRANCH=main

# Optional: live YouTube numbers in the Hub and automatic videos on the site.
YOUTUBE_API_KEY=
